[Unit]
Description=Job Assistant (求职助手)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/job-assistant
EnvironmentFile=/opt/job-assistant/.env
ExecStart=/opt/job-assistant/bin/job-assistant
Restart=on-failure
RestartSec=3
User=root
# 建议改为普通用户并授予目录权限

[Install]
WantedBy=multi-user.target
